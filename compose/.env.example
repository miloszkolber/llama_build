# General
REGISTRY=ghcr.io/miloszkolber
MODELS_DIR=./models
CACHE_DIR=./cache
DRI_RENDER=/dev/dri/renderD128
RENDER_GID=1000
DOCKER_GID=1000
TZ=Europe/Warsaw
GATE_HOST=127.0.0.1
IDLE_TIMEOUT=300
STARTUP_TIMEOUT=180
CONNECTION_IDLE_TIMEOUT=600

# Llama
# LLAMA_PROXY_PORT replaces the deployment's LLAMA_HOST_PORT.
LLAMA_PROXY_PORT=4667
LLAMA_ARG_HOST=127.0.0.1
LLAMA_ARG_PORT=9668
LLAMA_ARG_SLEEP_IDLE_SECONDS=600
LLAMA_ARG_MODELS_PRESET=/models.ini
LLAMA_ARG_MODELS_MAX=2
LLAMA_ARG_FIT=off
LLAMA_ARG_DEVICE=SYCL0
LLAMA_ARG_SPLIT_MODE=none
LLAMA_ARG_MMPROJ_OFFLOAD=on
LLAMA_ARG_THREADS=6
LLAMA_ARG_THREADS_BATCH=6
# mlock requires deployment-specific memlock limits/permissions.
LLAMA_ARG_LOAD_MODE=mlock
LLAMA_ARG_BATCH=2048
LLAMA_ARG_UBATCH=512
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CACHE_RAM=0
LLAMA_ARG_JINJA=on
LLAMA_ARG_UI=0
ONEAPI_DEVICE_SELECTOR=level_zero:0
GGML_SYCL_USE_LEVEL_ZERO_API=1
GGML_SYCL_ENABLE_FLASH_ATTN=1
GGML_SYCL_ENABLE_GRAPH=0
GGML_SYCL_ENABLE_OPT=1
GGML_SYCL_ENABLE_DNN=1
GGML_SYCL_ENABLE_VMM=1
GGML_SYCL_ENABLE_FUSION=1
GGML_SYCL_ENABLE_MKL_FA=1
GGML_SYCL_USM_SYSTEM=0
GGML_SYCL_ENABLE_HOST_PINNED_MEM=0
ZES_ENABLE_SYSMAN=1
UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS=1

# Whisper
WHISPER_PROXY_PORT=4670
GGML_VK_VISIBLE_DEVICES=0
XDG_CACHE_HOME=/tmp
WHISPER_HOST=127.0.0.1
WHISPER_PORT=9670
WHISPER_MODEL=/models/ggml-large-v3.bin
WHISPER_THREADS=6
WHISPER_LANGUAGE=auto
WHISPER_INFERENCE_PATH=/v1/audio/transcriptions
WHISPER_VAD_ENABLED=1
WHISPER_VAD_MODEL=/models/ggml-silero-v5.1.2.bin
WHISPER_VAD_THRESHOLD=0.5
