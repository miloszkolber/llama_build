{
  "version": 1,
  "profile": "persistent-proxy",
  "docker_socket": "/var/run/docker.sock",
  "idle_timeout_seconds": 300,
  "startup_timeout_seconds": 180,
  "connection_idle_timeout_seconds": 600,
  "persistent_proxy": {
    "backends": [
      { "name": "llama", "runtime_name": "llama-runtime", "listen_host": "127.0.0.1", "listen_port": 4667, "upstream_port": 9668, "health_path": "/health" },
      { "name": "whisper", "runtime_name": "whisper-runtime", "listen_host": "127.0.0.1", "listen_port": 4670, "upstream_port": 9670, "health_path": "/" }
    ]
  }
}
